name = "free-hp-engine"
main = "src/index.ts"
compatibility_date = "2026-07-22"

# Your Cloudflare account ID (found in the Cloudflare dashboard sidebar).
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

[ai]
binding = "AI"

[[kv_namespaces]]
binding = "SITES"
# Create with: npx wrangler kv namespace create SITES
id = "YOUR_KV_NAMESPACE_ID"

[vars]
PUBLIC_BASE_URL = "https://your-worker-subdomain.workers.dev"
# Googleログインのクライアント ID（公開値。これを設定した瞬間に登録制が有効になる）
GOOGLE_CLIENT_ID = "YOUR_GOOGLE_OAUTH_CLIENT_ID"

# Before the first deployment, set the secret without putting it in source control:
# npx wrangler secret put ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY未設定時はCloudflare Workers AI（上の[ai] binding、無料・キー不要）に自動フォールバックする。

# Copy this file to wrangler.toml and fill in the placeholders above.
# wrangler.toml is gitignored so your real account_id / KV namespace id
# never get committed.
